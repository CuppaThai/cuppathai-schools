---
export interface Props {
  title: string;
  description?: string;
  lang?: 'th' | 'en';
}
const { title, description, lang = 'th' } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} | CuppaThai Instruction Book</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico">
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Sarabun', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #F2EFEA;
        color: #3D2B1F;
        padding: 2rem 1rem;
        line-height: 1.6;
      }
      .container {
        max-width: 1000px;
        margin: 0 auto;
        background: #fff;
        border-radius: 24px;
        padding: 2.5rem 3rem;
        box-shadow: 0 4px 30px rgba(0,0,0,0.06);
      }
      h1, h2, h3, h4 {
        font-family: 'Playfair Display', Georgia, serif;
        color: #7F2824;
        letter-spacing: -0.01em;
      }
      h1 { font-size: 2.2rem; border-bottom: 3px solid #BFAC95; padding-bottom: 0.25rem; margin-bottom: 1.5rem; }
      h2 { font-size: 1.8rem; margin-top: 2rem; border-bottom: 2px solid #BFAC95; padding-bottom: 0.2rem; }
      h3 { font-size: 1.4rem; margin-top: 1.5rem; }
      p, li { font-size: 1rem; }
      ul, ol { padding-left: 1.8rem; margin: 0.5rem 0 1rem; }
      li { margin: 0.3rem 0; }
      .lang-switch {
        display: inline-block;
        background: #EDE9E2;
        border-radius: 40px;
        padding: 2px 4px;
        margin-bottom: 1rem;
      }
      .lang-switch a {
        display: inline-block;
        padding: 4px 16px;
        border-radius: 40px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.85rem;
        color: #7A6A5A;
        transition: all 0.2s;
      }
      .lang-switch a.active {
        background: #7F2824;
        color: #fff;
      }
      .lang-switch a:hover:not(.active) {
        background: #D5C8B8;
      }
      @media (max-width: 600px) {
        .container { padding: 1.5rem 1rem; }
        h1 { font-size: 1.6rem; }
        h2 { font-size: 1.3rem; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="lang-switch">
        <a href="/th/" class={lang === 'th' ? 'active' : ''}>ไทย</a>
        <a href="/en/" class={lang === 'en' ? 'active' : ''}>EN</a>
      </div>
      <slot />
    </div>
  </body>
</html>
