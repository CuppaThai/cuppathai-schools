<script>
  (function () {
    let currentLang = 'th';

    function getCookie(n) {
      const m = document.cookie.match(new RegExp('(^| )' + n + '=([^;]+)'));
      return m ? m[2] : null;
    }

    function applyLanguage() {
      document.querySelectorAll('[data-th][data-en]').forEach(function (el) {
        el.textContent = el.getAttribute('data-' + currentLang);
      });
    }

    function setLang(lang) {
      currentLang = lang;
      document.cookie = 'ct_lang=' + lang + '; path=/; max-age=31536000';
      var th = document.getElementById('lang-th');
      var en = document.getElementById('lang-en');
      if (th) th.classList.toggle('active', lang === 'th');
      if (en) en.classList.toggle('active', lang === 'en');
      applyLanguage();
    }

    // Wire up the buttons themselves — no inline onclick needed
    var thBtn = document.getElementById('lang-th');
    var enBtn = document.getElementById('lang-en');
    if (thBtn) thBtn.addEventListener('click', function () { setLang('th'); });
    if (enBtn) enBtn.addEventListener('click', function () { setLang('en'); });

    // Init on page load — remember choice via ct_lang cookie
    setLang(getCookie('ct_lang') === 'en' ? 'en' : 'th');
  })();
</script>

