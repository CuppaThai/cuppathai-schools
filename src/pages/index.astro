---
// CuppaThai — For Schools | Complete single-file Astro page
---

<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CuppaThai — For Schools | English Communication Series</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Sarabun:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Sarabun', sans-serif;
      background: #F2EFEA;
      color: #3D2B1F;
      padding: 20px;
    }
    .container {
      max-width: 1100px;
      margin: 0 auto;
      background: #fff;
      border-radius: 24px;
      padding: 40px 50px;
      box-shadow: 0 4px 30px rgba(0,0,0,0.06);
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      border-bottom: 2px solid #BFAC95;
      padding-bottom: 16px;
      margin-bottom: 32px;
    }
    .logo {
      font-family: 'Playfair Display', serif;
      font-size: 2rem;
      color: #7F2824;
    }
    .logo span { color: #3D2B1F; font-weight: 400; }
    .lang-toggle {
      display: flex;
      gap: 4px;
      background: #EDE9E2;
      border-radius: 40px;
      padding: 3px;
    }
    .lang-toggle button {
      border: none;
      background: transparent;
      padding: 6px 16px;
      border-radius: 40px;
      font-family: 'Sarabun', sans-serif;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      color: #7A6A5A;
      transition: all 0.2s;
    }
    .lang-toggle button.active {
      background: #7F2824;
      color: white;
    }
    .badge {
      background: #7F2824;
      color: #fff;
      padding: 6px 18px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.7rem;
      letter-spacing: 0.5px;
    }
    .badge-demo {
      background: #B8860B;
      margin-left: 8px;
    }
    .badge-offline {
      background: #2E6E4E;
      margin-left: 8px;
    }
    .badge-voicelab {
      background: #1A5276;
      margin-left: 8px;
    }

    h1 { font-family: 'Playfair Display', serif; font-size: 2rem; color: #7F2824; margin-bottom: 4px; }
    .sub { font-size: 1.1rem; color: #7A6A5A; margin-bottom: 24px; }

    .section-title { 
      font-family: 'Playfair Display', serif; 
      font-size: 1.3rem; 
      color: #7F2824; 
      margin-top: 36px; 
      border-bottom: 2px solid #BFAC95; 
      padding-bottom: 6px; 
    }

    .progression-wrap {
      background: #F8F5F0;
      border-radius: 16px;
      padding: 20px 24px;
      margin: 16px 0;
      border: 1px solid #EDE9E2;
      overflow-x: auto;
    }
    .progression-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
      min-width: 500px;
    }
    .progression-table th {
      background: #7F2824;
      color: #fff;
      padding: 10px 14px;
      text-align: left;
      font-weight: 600;
    }
    .progression-table td {
      padding: 10px 14px;
      border-bottom: 1px solid #EDE9E2;
    }
    .progression-table tr:last-child td { border-bottom: none; }
    .progression-table tr:hover td { background: #FDF7E8; }
    .progression-table .level-badge {
      display: inline-block;
      background: #7F2824;
      color: #fff;
      padding: 2px 12px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.7rem;
    }
    .progression-table .level-badge.m2 { background: #2E86C1; }
    .progression-table .level-badge.m3 { background: #28B463; }
    .progression-table .level-badge.m4 { background: #F39C12; }
    .progression-table .level-badge.m5 { background: #E67E22; }
    .progression-table .level-badge.m6 { background: #E74C3C; }

    .progression-banner {
      background: linear-gradient(135deg, #7F2824 0%, #5F1E1A 100%);
      border-radius: 16px;
      padding: 20px 28px;
      margin: 16px 0 24px 0;
      color: #fff;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .progression-banner .label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      opacity: 0.8;
    }
    .progression-banner .levels {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }
    .progression-banner .level {
      background: rgba(255,255,255,0.15);
      padding: 4px 14px;
      border-radius: 40px;
      font-weight: 700;
      font-size: 0.85rem;
    }
    .progression-banner .level .grade {
      font-weight: 400;
      font-size: 0.6rem;
      opacity: 0.7;
      display: block;
    }
    .progression-banner .level.active {
      background: rgba(255,255,255,0.3);
      border: 2px solid #F1C40F;
    }
    .progression-banner .arrow {
      font-size: 1.2rem;
      opacity: 0.6;
      color: #F1C40F;
    }

    .how-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin: 20px 0;
    }
    .how-step {
      text-align: center;
      background: #F2EFEA;
      border-radius: 12px;
      padding: 12px;
    }
    .how-step .icon { font-size: 1.6rem; }
    .how-step .label { font-weight: 700; font-size: 0.85rem; }
    .how-step .desc { font-size: 0.7rem; color: #7A6A5A; }

    .demo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin: 20px 0;
    }
    .demo-card {
      background: #FCFBF9;
      border: 2px solid #EDE9E2;
      border-radius: 16px;
      padding: 20px 16px;
      text-align: center;
      transition: all 0.3s ease;
    }
    .demo-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.08);
      border-color: #7F2824;
    }
    .demo-card .icon { font-size: 2.8rem; display: block; margin-bottom: 4px; }
    .demo-card .role-label {
      display: inline-block;
      background: #7F2824;
      color: #fff;
      font-weight: 700;
      font-size: 0.6rem;
      padding: 4px 14px;
      border-radius: 40px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .demo-card .role-label.green { background: #2E6E4E; }
    .demo-card .role-label.gold { background: #B8860B; }
    .demo-card .role-label.dark { background: #2A1A0E; }
    .demo-card h4 { font-size: 1rem; color: #1e1a16; margin-bottom: 2px; }
    .demo-card .desc { font-size: 0.75rem; color: #7A6A5A; margin-bottom: 10px; }
    .demo-card .creds {
      background: #F2EFEA;
      border-radius: 10px;
      padding: 8px;
      margin: 8px 0;
      font-size: 0.75rem;
    }
    .demo-card .creds .label { 
      color: #7A6A5A; 
      font-size: 0.6rem; 
      text-transform: uppercase; 
      font-weight: 600; 
      display: block;
    }
    .demo-card .creds .value { 
      font-family: 'Courier New', monospace; 
      font-weight: 700; 
      color: #3D2B1F; 
    }
    .demo-card .creds .row {
      margin-top: 4px;
    }
    .demo-card .creds .row:first-child {
      margin-top: 0;
    }
    
    .btn {
      display: inline-block;
      background: #7F2824;
      color: #fff;
      padding: 8px 24px;
      border-radius: 40px;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.8rem;
      transition: all 0.2s ease;
      border: none;
      cursor: pointer;
      margin-top: 4px;
    }
    .btn:hover { background: #5F1E1A; transform: scale(1.03); }
    .btn-green { background: #2E6E4E; }
    .btn-green:hover { background: #1D4D34; }
    .btn-gold { background: #B8860B; }
    .btn-gold:hover { background: #8B6900; }
    .btn-outline {
      background: transparent;
      color: #7F2824;
      border: 2px solid #7F2824;
    }
    .btn-outline:hover { background: #7F2824; color: #fff; }
    .btn-sm { padding: 6px 16px; font-size: 0.7rem; }
    .btn-blue {
      background: #1A5276;
    }
    .btn-blue:hover { background: #0E3A55; }

    .demo-note {
      background: #FDF7E8;
      border-left: 6px solid #B8860B;
      border-radius: 0 12px 12px 0;
      padding: 14px 20px;
      margin: 16px 0;
      font-size: 0.9rem;
    }
    .demo-note strong { color: #7F2824; }

    .step-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin: 12px 0;
    }
    .step-card {
      background: #F2EFEA;
      border-radius: 12px;
      padding: 14px 16px;
    }
    .step-card .num {
      background: #7F2824;
      color: #fff;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.8rem;
      margin-bottom: 4px;
    }
    .step-card h4 { font-weight: 700; font-size: 0.9rem; }
    .step-card p { font-size: 0.75rem; color: #7A6A5A; }

    .video-wrapper {
      position: relative;
      width: 100%;
      max-width: 400px;
      margin: 16px auto;
      aspect-ratio: 9 / 16;
      background: #1e1a16;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 30px rgba(0,0,0,0.2);
    }
    .video-wrapper video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 16px;
    }
    .video-caption {
      text-align: center;
      font-size: 0.85rem;
      color: #7A6A5A;
      margin-top: 4px;
    }

    .epub-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #FDF7E8;
      padding: 2px 12px 2px 8px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.7rem;
      color: #7F2824;
      border: 1px solid #BFAC95;
    }

    .epub-box {
      background: #FDF7E8;
      border-left: 4px solid #B8860B;
      padding: 14px 20px;
      border-radius: 0 12px 12px 0;
      margin: 20px 0;
      font-size: 0.9rem;
    }

    .voicelab-section {
      background: linear-gradient(135deg, #1A5276 0%, #2E86C1 100%);
      border-radius: 16px;
      padding: 28px 32px;
      margin: 24px 0;
      color: white;
      text-align: center;
    }
    .voicelab-section .icon { font-size: 2.5rem; margin-bottom: 8px; }
    .voicelab-section h3 {
      font-family: 'Playfair Display', serif;
      font-size: 1.3rem;
      color: white;
      margin-bottom: 4px;
    }
    .voicelab-section p {
      color: rgba(255,255,255,0.85);
      font-size: 0.9rem;
      margin-bottom: 14px;
    }
    .voicelab-section .btn-voicelab {
      display: inline-block;
      background: white;
      color: #1A5276;
      padding: 10px 36px;
      border-radius: 40px;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.95rem;
      transition: all 0.2s ease;
    }
    .voicelab-section .btn-voicelab:hover {
      transform: scale(1.04);
      box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    }
    .voicelab-section .lock-note {
      font-size: 0.65rem;
      color: rgba(255,255,255,0.5);
      margin-top: 8px;
    }

    .cta-section {
      background: linear-gradient(135deg, #FDF7E8 0%, #F2EFEA 100%);
      border-radius: 24px;
      padding: 32px 40px;
      text-align: center;
      margin: 24px 0;
    }
    .cta-section h3 {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      color: #7F2824;
      margin-bottom: 8px;
    }
    .cta-section p { color: #5A4A3A; margin-bottom: 16px; }
    .cta-section .btn-group {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .privacy-box {
      background: #EEF7F1;
      border-left: 4px solid #2E6E4E;
      padding: 14px 20px;
      border-radius: 0 12px 12px 0;
      margin: 20px 0;
      font-size: 0.9rem;
    }

    .footer {
      border-top: 1px solid #EDE9E2;
      padding-top: 20px;
      margin-top: 36px;
      font-size: 0.75rem;
      color: #BFAC95;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
    }

    ul, ol { padding-left: 24px; margin: 8px 0; }
    li { margin: 4px 0; }

    @media (max-width: 700px) {
      .container { padding: 24px 16px; }
      .how-grid { grid-template-columns: 1fr 1fr; }
      .step-grid { grid-template-columns: 1fr 1fr; }
      .demo-grid { grid-template-columns: 1fr 1fr; }
      .cta-section { padding: 24px 20px; }
      .voicelab-section { padding: 20px 16px; }
      .progression-banner { flex-direction: column; text-align: center; }
      .progression-banner .levels { justify-content: center; }
      .video-wrapper { max-width: 280px; }
    }
    @media (max-width: 480px) {
      .how-grid { grid-template-columns: 1fr; }
      .step-grid { grid-template-columns: 1fr; }
      .demo-grid { grid-template-columns: 1fr; }
      .header { flex-direction: column; gap: 12px; align-items: stretch; }
      .lang-toggle { align-self: center; }
      .video-wrapper { max-width: 220px; }
      .voicelab-section .btn-voicelab { display: block; }
    }
  </style>
</head>
<body>

<div class="container">

  <!-- ═══════ HEADER ═══════ -->
  <div class="header">
    <div class="logo">Cuppa<span>Thai</span></div>
    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
      <span class="badge">🏫 For Schools</span>
      <span class="badge badge-demo">🚀 Demo</span>
      <span class="badge badge-offline">📶 Offline</span>
      <span class="badge badge-voicelab">🎙️ VoiceLab</span>
      <div class="lang-toggle">
        <button class="active" id="lang-th">ไทย</button>
        <button id="lang-en">EN</button>
      </div>
    </div>
  </div>

  <!-- ═══════ HERO ═══════ -->
  <h1 data-th="ครูไม่ต้องพูดภาษาอังกฤษ — AI เป็นครูสอนภาษา" data-en="Teachers don't speak English — AI is the language teacher">ครูไม่ต้องพูดภาษาอังกฤษ — AI เป็นครูสอนภาษา</h1>
  <p class="sub" data-th="หลักสูตรครบ 5 ปี ม.2–ม.6 · 50 แพ็ก · 2,400 ประโยค · AI ให้คะแนนทันที" data-en="Complete 5-year curriculum Mor 2–Mor 6 · 50 packs · 2,400 phrases · AI scores instantly">หลักสูตรครบ 5 ปี ม.2–ม.6 · 50 แพ็ก · 2,400 ประโยค · AI ให้คะแนนทันที</p>

  <!-- ═══════ PROGRESSION BANNER ═══════ -->
  <div class="progression-banner">
    <div>
      <div class="label" data-th="📈 ก้าวหน้าตามระดับชั้น" data-en="📈 Progress by Grade Level">📈 ก้าวหน้าตามระดับชั้น</div>
      <div style="font-weight:700; font-size:1.1rem; margin-top:2px;" data-th="ม.2 → ม.6 ครบ 5 ปี" data-en="Mor 2 → Mor 6 Complete 5 Years">ม.2 → ม.6 ครบ 5 ปี</div>
    </div>
    <div class="levels">
      <div class="level active">
        ม.2
        <span class="grade" data-th="เริ่มต้น" data-en="Beginner">เริ่มต้น</span>
      </div>
      <div class="arrow">→</div>
      <div class="level">
        ม.3
        <span class="grade" data-th="พื้นฐาน" data-en="Basic">พื้นฐาน</span>
      </div>
      <div class="arrow">→</div>
      <div class="level">
        ม.4
        <span class="grade" data-th="ระดับกลาง" data-en="Intermediate">ระดับกลาง</span>
      </div>
      <div class="arrow">→</div>
      <div class="level">
        ม.5
        <span class="grade" data-th="ระดับกลาง-สูง" data-en="Upper-Intermediate">ระดับกลาง-สูง</span>
      </div>
      <div class="arrow">→</div>
      <div class="level">
        ม.6
        <span class="grade" data-th="ระดับสูง" data-en="Advanced">ระดับสูง</span>
      </div>
    </div>
  </div>

  <!-- ═══════ PROGRESSION TABLE ═══════ -->
  <div class="progression-wrap">
    <table class="progression-table">
      <thead>
        <tr>
          <th data-th="ระดับชั้น" data-en="Grade Level">ระดับชั้น</th>
          <th data-th="ระดับความสามารถ" data-en="Proficiency Level">ระดับความสามารถ</th>
          <th data-th="จำนวนแพ็ก" data-en="Number of Packs">จำนวนแพ็ก</th>
          <th data-th="จำนวนประโยค" data-en="Number of Phrases">จำนวนประโยค</th>
          <th data-th="ความสามารถที่พัฒนา" data-en="Competency Developed">ความสามารถที่พัฒนา</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong data-th="ม.2" data-en="Mor 2">ม.2</strong></td>
          <td><span class="level-badge m2" data-th="เริ่มต้น" data-en="Beginner">เริ่มต้น</span></td>
          <td>10 แพ็ก</td>
          <td>480 ประโยค</td>
          <td data-th="พื้นฐานเบื้องต้น" data-en="Basic fundamentals">พื้นฐานเบื้องต้น</td>
        </tr>
        <tr>
          <td><strong data-th="ม.3" data-en="Mor 3">ม.3</strong></td>
          <td><span class="level-badge m3" data-th="พื้นฐาน" data-en="Basic">พื้นฐาน</span></td>
          <td>10 แพ็ก</td>
          <td>480 ประโยค</td>
          <td data-th="สื่อสารพื้นฐานได้" data-en="Basic communication">สื่อสารพื้นฐานได้</td>
        </tr>
        <tr>
          <td><strong data-th="ม.4" data-en="Mor 4">ม.4</strong></td>
          <td><span class="level-badge m4" data-th="ระดับกลาง" data-en="Intermediate">ระดับกลาง</span></td>
          <td>10 แพ็ก</td>
          <td>480 ประโยค</td>
          <td data-th="สื่อสารในชีวิตประจำวัน" data-en="Everyday communication">สื่อสารในชีวิตประจำวัน</td>
        </tr>
        <tr>
          <td><strong data-th="ม.5" data-en="Mor 5">ม.5</strong></td>
          <td><span class="level-badge m5" data-th="ระดับกลาง-สูง" data-en="Upper-Intermediate">ระดับกลาง-สูง</span></td>
          <td>10 แพ็ก</td>
          <td>480 ประโยค</td>
          <td data-th="สื่อสารในสถานการณ์ต่างๆ" data-en="Communicate in various situations">สื่อสารในสถานการณ์ต่างๆ</td>
        </tr>
        <tr>
          <td><strong data-th="ม.6" data-en="Mor 6">ม.6</strong></td>
          <td><span class="level-badge m6" data-th="ระดับสูง" data-en="Advanced">ระดับสูง</span></td>
          <td>10 แพ็ก</td>
          <td>480 ประโยค</td>
          <td data-th="สื่อสารได้คล่องแคล่ว" data-en="Fluent communication">สื่อสารได้คล่องแคล่ว</td>
        </tr>
        <tr style="background:#FDF7E8; font-weight:700;">
          <td data-th="รวมทั้งหมด" data-en="Total">รวมทั้งหมด</td>
          <td data-th="ม.2 – ม.6" data-en="Mor 2 – Mor 6">ม.2 – ม.6</td>
          <td>50 แพ็ก</td>
          <td>2,400 ประโยค</td>
          <td data-th="หลักสูตรครบ 5 ปี" data-en="Complete 5-year curriculum">หลักสูตรครบ 5 ปี</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- ═══════ HOW IT WORKS ═══════ -->
  <h2 class="section-title" data-th="📖 ระบบทำงานอย่างไร" data-en="📖 How It Works">📖 ระบบทำงานอย่างไร</h2>
  <div class="how-grid">
    <div class="how-step">
      <div class="icon">📖</div>
